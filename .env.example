# Obligatoria: sin ella la app no arranca.
LLM_API_KEY=
# Vacio usa el endpoint de OpenAI. Para local (Ollama, LM Studio) pon su URL de API.
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Default global para cualquier rol sin su propio LLM_*_MAX_TOKENS.
LLM_MAX_TOKENS=2048
# Topes por rol (opcionales: cada rol que no se defina cae a LLM_MAX_TOKENS).
# El extractor debe devolver el JSON completo (summary + 5 dimensiones): un tope
# bajo trunca el JSON y el parser rechaza la respuesta.
LLM_EXTRACTOR_MAX_TOKENS=2000
LLM_ANALYZER_MAX_TOKENS=800
LLM_WRITER_MAX_TOKENS=2048
LLM_AUDITOR_MAX_TOKENS=300

# Timeout por llamada en segundos.
LLM_TIMEOUT_SECONDS=60.0

# Umbral de varianza del auditor (0..1, default 0.45). Por encima se reintenta
# el writer. Forma parte del gate dual: la aprobación requiere varianza <= umbral
# Y IC >= MATCH_TARGET_IC.
AUDIT_VARIANCE_THRESHOLD=0.45

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cvaligner
DB_USER=postgres
DB_PASSWORD=postgresql

#JWT Configuration
JWT_SECRET_KEY=secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Scoring cuantitativo (IC). Los pesos deben sumar 1.
MATCH_TARGET_IC=85
MATCH_WEIGHT_NCOS=0.50
MATCH_WEIGHT_NTFIDF=0.30
MATCH_WEIGHT_NEUC=0.20
# Usa el mismo endpoint que el LLM (LLM_BASE_URL si está configurado).
MATCH_EMBEDDING_MODEL=text-embedding-3-small
# Origenes permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# S3 / LocalStack. Para AWS real, ajusta endpoint, region y credenciales.
S3_ENDPOINT_URL=http://localhost:4566
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=cv-aligner-cvs
S3_USE_SSL=false
